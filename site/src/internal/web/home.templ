package web

templ Page(title string) {
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{ title }</title>
        <!-- Load HTMX via CDN -->
        <!-- TODO: Staticly embed in binary-->

        <script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js"></script>
    </head>
    <body>
        <h1>Go + Templ + HTMX Server</h1>
        
        <!-- Container where the updated content will swap -->
        <div id="message-container">
            @Content("Click the button below to update this area via HTMX.")
        </div>

        <!-- HTMX button hitting the server asynchronously -->
        <button 
            hx-post="/update" 
            hx-target="#message-container" 
            hx-swap="innerHTML"
        >
            Trigger Server Update
        </button>
    </body>
    </html>
}

templ Content(message string) {
    <p><strong>Server Message:</strong> { message }</p>
}
