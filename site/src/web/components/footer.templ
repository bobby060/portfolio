package components

import (
	"strconv"
	"time"
)

templ footer() {
	<footer class="bg-light text-neutral-500">
		<div class="mx-auto mt-5 max-w-6xl px-4 pt-2">
			<div class="mt-3 md:flex md:justify-center md:gap-16">
				<section class="mb-4 text-center md:w-5/12 md:text-left lg:w-4/12">
					<h6 class="mb-4 font-bold uppercase">About this site</h6>
					<p>
						I created this site both to share my love for photography and also as an experiment to
						renew my coding skills. If you want to find out more about how I built this website, please
						check out my <a href="https://github.com/bobby060/site" class="underline">Github</a>{ " for this project!" }
					</p>
				</section>
				<section class="mb-4 text-center md:w-5/12 md:text-left lg:w-4/12">
					<h6 class="mb-4 font-bold uppercase">Find Me</h6>
					<p class="mt-2"><a href="https://github.com/bobby060/" target="_blank" rel="noopener" class="hover:text-neutral-700">Github</a></p>
					<p class="mt-2"><a href="https://www.linkedin.com/in/robert-p-norwood/" target="_blank" rel="noopener" class="hover:text-neutral-700">LinkedIn</a></p>
				</section>
			</div>
		</div>
		<div class="bg-black/5 p-4 text-center">
			© { strconv.Itoa(time.Now().Year()) } Robert Norwood
		</div>
	</footer>
}
