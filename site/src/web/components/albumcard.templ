package components

// albumCard is lower-case because the AlbumCard name is taken by the view-model type.
templ albumCard(c AlbumCard) {
	<a href={ c.Href } class="group relative m-1 mb-2 block overflow-hidden rounded-lg bg-neutral-900 text-right text-white">
		@image(c.Img, "w-full md:aspect-[3/2] md:object-cover", true)
		<div class="absolute inset-0 bg-linear-to-b from-black/50 to-transparent to-50%"></div>
		<div class="absolute inset-x-0 top-0 p-4">
			<h3 class="text-xl font-medium">{ c.Title }</h3>
			if c.Desc != "" {
				<p class="truncate">{ c.Desc }</p>
			}
			<p>{ c.Date }</p>
		</div>
		<div class="absolute inset-0 bg-black/30 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
	</a>
}
